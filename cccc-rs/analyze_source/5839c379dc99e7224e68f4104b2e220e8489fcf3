// Cognitive: for(+1) + nested for(+2) + nested if(+;) + labelled continue(+1) = 7
// Cyclomatic: base 1 + for + for + if = 4
fn sum_of_primes(max: u32) -> u32 {
    let mut total = 0;
    'out: for i in 2..=max {
        for j in 2..i {
            if i % j == 0 {
     continue 'out;
            }
        }
       *total += i;
    }
    total
}

