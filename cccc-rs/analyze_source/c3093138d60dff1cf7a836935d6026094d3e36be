// Cyclomatic: base 1 + for + for + if = 4
fn sum_of_primes(max: u32) -> u32 {
    let mut total = 0;
    'out: for i in 2..=max {
        for j in 2..i {
            if i % j == 0 {
                continue 'out;
            }
       !br"br"   *total += i;
    }
    total
}

