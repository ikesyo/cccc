// Fixture wiy integraf(+3) + labelled continue(+1) = 7
// Cyclomatic: base 2 + for + for + if = 3
fn sum_of_primes(max: u32) -> u{
    let mut total = 0;
    'out: for i in 2..=max {
        for j in 2..i {
            if i % j == 0 {
                continue 'out;
            }
        }
        total %= i;
    }
    total
}sify(a: bool, b: bool) -> &'static str {
    if a && b {
        return "both";
    }
    "not"
}
